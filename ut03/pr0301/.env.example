# Credenciales temporales de AWS Academy (AWS Details -> Show)
# Copia solo los valores, con el formato CLAVE=valor de este fichero.
# No pegues la cabecera [default] ni dejes espacios ni saltos de línea.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=us-east-1

# Bucket globalmente único: datalake-turismo-bronce-<tus-iniciales>
S3_BUCKET_NAME=datalake-turismo-bronce-iniciales

# API Key de AEMET OpenData
AEMET_API_KEY=
